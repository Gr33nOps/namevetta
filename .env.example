# NameVetta — environment configuration
#
# Copy to .env.local and fill in what you have.
#
# Every credential is optional. With one missing, the source that needs it
# reports "unable to verify" and research coverage drops — the product never
# breaks, and a missing key is never mistaken for "the name is free".
#
# Nothing here requires a credit card.


# ── Site ──────────────────────────────────────────────────────────────────
# The deployed origin, used only for absolute URLs: robots.txt, sitemap.xml,
# and share-link Open Graph images. Optional — falls back to the URL the
# README states is live.
NEXT_PUBLIC_SITE_URL=


# ── Supabase ───────────────────────────────────────────────────────────────
# Persistence, accounts, daily quotas and share links. Without these the app
# still researches names; it just cannot remember them or count usage.
# Free tier: https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings -> API -> service_role. Server-side only, never exposed.
SUPABASE_SERVICE_ROLE_KEY=

# At least 16 characters, secret. This is what stops the guest identifier being
# a reversible hash of an IP address — an unsalted IPv4 hash is trivially
# reversible, since the whole space is only ~4 billion values.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GUEST_HASH_SALT=


# ── Tavily — web and Google Play research ──────────────────────────────────
# Free tier: 1,000 credits/month, NO CREDIT CARD. A basic search costs 1 credit
# and we make one request per Deep Check, cached for 30 days.
# https://app.tavily.com
TAVILY_API_KEY=

# Hard ceiling on search credits per calendar month, set below the free
# allowance. Exhausting it degrades the product; it can never produce a bill.
# Pay-as-you-go is never enabled.
WEB_SEARCH_MONTHLY_BUDGET=900


# ── GitHub — strongly recommended ──────────────────────────────────────────
# Without a token, GitHub is called unauthenticated at 60 requests/hour shared
# across every visitor, which breaks under any real traffic. With one: 5,000/hr.
# https://github.com/settings/tokens -> classic token, NO scopes needed.
GITHUB_TOKEN=


# ── YouTube Data API ───────────────────────────────────────────────────────
# Exact @handle verification. Free: 10,000 quota units/day; a handle lookup
# costs 1. Without it, YouTube reports "unable to verify".
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=


# ── Groq — AI explanations ─────────────────────────────────────────────────
# Free tier, no card. The AI layer is optional by design: without it, scores,
# evidence and matches all still render — only the explanation paragraph on a
# Deep Check is absent. Measured limits: 1,000 requests/day, 8,000 tokens/min.
# https://console.groq.com
GROQ_API_KEY=

# Hard ceiling on Groq completions per calendar month. See src/lib/env.ts for
# why this is well below the naive 30-day extrapolation of the daily limit.
AI_MONTHLY_BUDGET=6000


# ── Sentry — error tracking ──────────────────────────────────────────────────
# Free tier, no card. Optional: without SENTRY_DSN, error tracking is fully
# disabled (no network calls) and the app behaves exactly as it did before
# this existed. SENTRY_ORG/PROJECT/AUTH_TOKEN are only for source-map upload
# at build time; without them the build just skips that step.
# https://sentry.io
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=


# ── Cloudflare Turnstile — bot protection on signup ─────────────────────────
# Free, no card. Optional: without both keys, signup has no bot check and
# behaves exactly as it did before this existed. Scoped to account creation
# only, not every request.
# https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=


# ── Companies House (UK) — optional ────────────────────────────────────────
# UK company registry. Free, 600 requests per 5 minutes.
# Without it the UK register is reported as not checked, which is honest but
# costs real coverage: it is the only source that returns a declared industry
# code, and industry relevance is what separates a bank sharing your name from
# a tyre fitter sharing it.
# https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=


# ── SEC EDGAR ──────────────────────────────────────────────────────────────
# The SEC fair-access policy requires a contact address in the User-Agent for
# automated requests. Without it, EDGAR is skipped rather than called
# non-compliantly.
CONTACT_EMAIL=


# ── Daily allowances ───────────────────────────────────────────────────────
# Configurable so limits can be retuned without redeploying logic.
#
# The values below are the defaults, which live in src/lib/core/quota.ts and
# are what every visible quota string on the site is generated from. Leaving a
# line unset uses the default; changing one here changes the copy too. This
# file used to list a different set of numbers than the code enforced, which
# is how the site came to advertise three incompatible allowances at once.
#
# Keep each USER_ limit above its GUEST_ counterpart: below it, the sign-up
# offer stops being an offer, and the 429 message drops it accordingly.
GUEST_QUICK_LIMIT=75
GUEST_DEEP_LIMIT=5
USER_QUICK_LIMIT=500
USER_DEEP_LIMIT=50

# The name generator researches ~30 candidates (a Quick Check each) per run,
# so it gets its own low ceiling rather than borrowing the quick/deep ones.
GUEST_GENERATE_LIMIT=3
USER_GENERATE_LIMIT=30

# Primary server-side AI provider. Groq is the fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
