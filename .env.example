# All credentials are optional. A missing key never breaks the app — the source
# that needs it reports "unable to verify" and research coverage drops, which is
# the honest outcome. Never let a missing key read as "the name is free".

# GitHub: raises the rate limit from 60 to 5,000 requests/hour.
# Create at https://github.com/settings/tokens — no scopes required for public data.
GITHUB_TOKEN=

# YouTube Data API v3 key. Without it, handle checks are skipped entirely.
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# No trademark registry credentials are needed. V1 performs no automated
# trademark research — Trademark Assist links users to the official free
# registries, which they search themselves. See docs/ARCHITECTURE.md.

# Brave Search. Metered: the free allowance is ~1,000 requests/month, which is
# the binding constraint on Deep Checks. WEB_SEARCH_MONTHLY_BUDGET is a hard
# stop below it so exhausting the quota degrades the product, never bills you.
BRAVE_API_KEY=
WEB_SEARCH_MONTHLY_BUDGET=900

# Groq — the AI explanation layer. Entirely optional by design (roadmap S25):
# without it, scores, evidence and matches all still render.
GROQ_API_KEY=

# Supabase. All four are required together; with any missing, the app still
# researches names but cannot persist them or enforce daily limits.
# GUEST_HASH_SALT must be at least 16 characters and kept secret — it is what
# stops the guest identifier being a reversible hash of an IP address.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GUEST_HASH_SALT=

# Daily allowances. Configurable so limits can change without redeploying logic.
GUEST_QUICK_LIMIT=5
GUEST_DEEP_LIMIT=1
USER_QUICK_LIMIT=25
USER_DEEP_LIMIT=5

# Sent in User-Agent. SEC EDGAR requires a contact address in requests.
CONTACT_EMAIL=
